APP_NAME=AI Engineer Assessment
APP_ENV=development
LOG_LEVEL=INFO

OPENAI_API_KEY=
ROUTER_MODEL=gpt-5.6-luna
ANSWER_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-large

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docker_kubernetes_v1

CHUNK_TARGET_TOKENS=500
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=75

RAG_TOP_K=8
RAG_FINAL_CONTEXT_K=5
RAG_SCORE_THRESHOLD=0.35

OPENAI_TIMEOUT=30
QDRANT_TIMEOUT=5
SUPERHERO_TIMEOUT=10
MAX_QUESTION_LENGTH=4000

# SUPERHERO_API_BASE_URL=https://superheroapi.com/api
SUPERHERO_API_BASE_URL=https://www.superheroapi.com/api.php
SUPERHERO_API_TOKEN=

CORS_ORIGINS=http://localhost:5000
